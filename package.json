{
  "name": "clox",
  "private": true,
  "version": "0.1.0",
  "description": "CLOX pre-launch — three simple apps (npm, no monorepo)",
  "scripts": {
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build:api": "npm --prefix api run build",
    "build:web": "npm --prefix web run build",
    "build:admin": "npm --prefix admin run build",
    "test:api": "npm --prefix api test",
    "test:e2e": "npm --prefix e2e test",
    "test:e2e:smoke": "npm --prefix e2e run test:smoke",
    "test:e2e:api": "npm --prefix e2e run test:api:serial",
    "test:edge": "npm --prefix api test -- --testPathPattern=\"edge|go-nogo|stripe|env.validation|roles.guard|scope.service|sender.service|compliance.service|health\"",
    "smoke": "node scripts/smoke-local.mjs",
    "db:generate": "npm --prefix api run prisma:generate",
    "db:migrate": "npm --prefix api exec -- prisma migrate deploy",
    "db:seed": "npm --prefix api run prisma:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  }
}
