{
  "name": "clox-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright smoke + API-backed edge-case suites for Phase 1 M0–M3",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep-invert \"API-backed\"",
    "test:api": "playwright test --grep \"API-backed\"",
    "test:api:serial": "playwright test --grep \"API-backed\" --workers=1",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
