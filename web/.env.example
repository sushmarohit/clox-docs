# Public site origin for SEO (canonical, OG, sitemap, JSON-LD).
# Local: http://localhost:5173  |  Production: https://clox.com.au (see .env.production)
# www should redirect to apex — do not set SITE_URL to https://www.clox.com.au
SITE_URL=https://clox.com.au
NEXT_PUBLIC_APP_NAME=CLOX
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Optional Search Console / Bing Webmaster verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Upstream Nest API (server-only; used by Next route handlers)
API_BASE_URL=http://localhost:3001/v1

# Optional browser fallback if calling API directly (prefer same-origin /api/leads/*)
NEXT_PUBLIC_API_BASE_URL=

# AI site guide (server-only)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
