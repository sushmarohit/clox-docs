# ── Shared / API (apps/api) ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL (+ PostGIS) — local Docker: npm run docker:up
DATABASE_URL=postgresql://clox:clox@localhost:5432/clox_prelaunch?schema=public

# Object storage (Phase 1 local filesystem — S3 later)
STORAGE_LOCAL_DIR=.data/uploads
# Optional ABR free GUID (Ops assist only — never auto-approve)
# ABR_GUID=
# Compliance expiry watchdog interval (ms). 0 = off
COMPLIANCE_WATCHDOG_MS=3600000

# JWT (admin auth)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# Gmail SMTP (Phase 0)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="CLOX <your-gmail@gmail.com>"
# Optional CC for investor lead confirmations
# INVEST_NOTIFY_EMAIL=invest@clox.com.au
# Set true to expose Swagger in production (default: on in non-production)
# ENABLE_OPENAPI=false
# TEMP: return OTP in API response for testing (default true — turn off later)
# EXPOSE_OTP_IN_RESPONSE=false

# Seed Super Admin (change before production)
SEED_SUPER_ADMIN_EMAIL=abc@example.com
SEED_SUPER_ADMIN_NAME=CLOX Super Admin
# M1 QA personas (OTP login)
# SEED_STATE_MASTER_EMAIL=state.vic@clox.test
# SEED_LOCAL_BDE_EMAIL=local.mel@clox.test
# SEED_SENDER_EMAIL=sender.qa@clox.test
# SEED_CARRIER_EMAIL=carrier.qa@clox.test
# SEED_DRIVER_EMAIL=driver.qa@clox.test

# Rate limiting (public forms)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# ── Public web (web/ Next.js) ────────────────────────────────────────────
SITE_URL=http://localhost:5173
NEXT_PUBLIC_APP_NAME=CLOX
NEXT_PUBLIC_DEFAULT_LOCALE=en
API_BASE_URL=http://localhost:3000/v1
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Admin web (admin/ Vite) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_APP_NAME=CLOX
VITE_DEFAULT_LOCALE=en
