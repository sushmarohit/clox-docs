# ── Shared / API (apps/api) ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL
DATABASE_URL=postgresql://clox:clox@localhost:5432/clox_prelaunch?schema=public

# JWT (admin auth)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# Gmail SMTP (Phase 0)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="CLOX <your-gmail@gmail.com>"
NOTIFY_EMAIL=abc@example.com
# Optional CC for investor lead notifications
# INVEST_NOTIFY_EMAIL=invest@clox.com.au
# Set true to expose Swagger in production (default: on in non-production)
# ENABLE_OPENAPI=false

# Seed Super Admin (change before production)
SEED_SUPER_ADMIN_EMAIL=abc@example.com
SEED_SUPER_ADMIN_NAME=CLOX Super Admin

# Rate limiting (public forms)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# ── Public web (apps/web-public) ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_APP_NAME=CLOX
VITE_DEFAULT_LOCALE=en

# ── Admin web (apps/web-admin) ───────────────────────────────────────────
# Use same VITE_* when running admin; duplicate in apps/web-admin/.env if needed
